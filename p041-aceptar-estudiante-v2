# p041-aceptar-estudiante-v2
# Solicite el nombre, sexo (h/m), edad y tres calificaciones de un aspirante
# Evaluar los datos y mostrar un mensaje de aceptado o rechazado
# Si es rechazado se debe mostrar el motivo



#print("\033[2J\033[H", end="")
print("\033[H\033[J", end="")

print("∴" * 70)
print("🏫                  Admisiones de la Universidad                  🏫")
print("∵" * 70)

nombre = input("Escribe tu nombre: ").upper()
sexo = input("Sexo (escribe [H] para hombre y [M] para mujer): ").upper()


print("…" * 70)

# Segundo filtro: verificar sexo

if sexo == "M":
    # Si persona es mujer, pasar al siguiente nivel de verificación
    print(f"{nombre}, ¡pasaste el primer filtro! \n⏳  Puedes continuar con el proceso.  ⏳")
        
    print("…" * 70)

    edad = int(input("Escribe tu edad: "))

    print("…" * 70)

    # Segundo filtro: verificar la edad
    if edad >= 21:
        # Si persona es mayor de 21, pasar al siguiente nivel de verificación
        print(f"{nombre}, ¡pasaste el segundo filtro! \n⏳  Puedes continuar con el proceso.  ⏳")
    
        print("…" * 70)

        print("Escribe 3 calificaciones (en base 10) separadas por un espacio: ")
        c1, c2, c3 = input().split()
        c1, c2, c3 = [float(c1), float(c2), float(c3)]

        print("…" * 70)

        # Segundo filtro: verificar las calificaciones
        if 0 <= c1 <= 10 and 0 <= c2 <= 10 and 0 <= c3 <= 10:
            print(f"Calificaciones ingresadas: {c1}, {c2}, {c3}.")
            print("⏳ Calculando promedio...⏳")
            prom = (c1 + c2 + c3)/3
            print(f"➡️  Tu promedio es {prom:.1f}")

            print("…" * 70)

            if prom >= 8 and prom <= 9.5:
                # Si se pasan ambos filtros (de edad y calificaciones)
                print(f"✔️  Bienvenida {nombre}, ¡fuiste aceptada!   ✔️\nCumpliste satisfactoriamente con los requisitos.")
        
            else:
                print(f"❌   ¡Lo sentimos, {nombre}!   ❌ \nSolamente aceptamos promedios entre 8 y 9.5.")
       
        else:
            print("❌  ¡Ha ocurrido un error!  ❌")
            print("Las calificaciones deben estar en base 10.")
            print(f"Ingresaste: {c1}, {c2}, {c3}.")
            print("Vuelve a intentarlo.")

    else:
        # Si la persona es menor de edad
        print(f"❌   ¡Lo sentimos, {nombre}!   ❌ \nSolamente aceptamos a mayores de 21 años.")

elif sexo == "H":
    # Si la persona es hombre
    print(f"❌   ¡Lo sentimos, {nombre}!   ❌ \nSolamente aceptamos mujeres.")

else:
    print("❌  ¡Ha ocurrido un error!  ❌")
    print(f"Escribiste {sexo}, diferente a H o M.")
    print("Vuelve a intentarlo.")
     


print("∴" * 70)
print("Fin del programa.")
print("∵" * 70)